# Production environment for the mew VPS. Copy to .env in this directory,
# replace every value and run: chmod 600 .env
# Never commit this file.

# Postgres
POSTGRES_USER=ferready
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_24
POSTGRES_DB=ferready

# Medusa secrets
JWT_SECRET=replace_with_openssl_rand_hex_32
COOKIE_SECRET=replace_with_openssl_rand_hex_32

# Public origin of the storefront. Used for CORS and for catalog image URLs.
STORE_CORS=https://ferready.odelza.com
ADMIN_CORS=https://ferready.odelza.com,http://localhost:18410
AUTH_CORS=https://ferready.odelza.com,http://localhost:18410
CATALOG_ASSET_ORIGIN=https://ferready.odelza.com

# Postgres connection pool per process. The default of 10 runs out during
# migrations with this many modules.
DB_POOL_MAX=20

# Filled after the backend bootstrap prints it.
MEDUSA_PUBLISHABLE_KEY=
